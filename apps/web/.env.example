# The admin API server (apps/admin). The waitlist form posts to
# $NEXT_PUBLIC_API_URL/api/v1/waitlist, so add this site's origin to
# WAITLIST_ALLOWED_ORIGINS in apps/admin/.env for production.
NEXT_PUBLIC_API_URL=http://localhost:3002

# Public origin of this site, for social preview image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3004
