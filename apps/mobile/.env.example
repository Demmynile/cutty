# # Not secrets — used only to build image URLs.
# EXPO_PUBLIC_SANITY_PROJECT_ID=
# EXPO_PUBLIC_SANITY_DATASET=production
# EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=
# # Origin of the apps/admin server, which hosts the API.
# # Physical device: your dev machine's LAN IP, e.g. http://192.168.1.23:3002
# # iOS simulator: http://localhost:3002   Android emulator: http://10.0.2.2:3002
# EXPO_PUBLIC_API_URL=
# # Origin of the apps/realtime chat server (Socket.IO). Same host rules as above,
# # e.g. http://192.168.1.23:4000 in development. Leave empty to disable live chat.
# EXPO_PUBLIC_REALTIME_URL=
# # Clerk publishable key (Clerk dashboard → API keys). Customers and Cutty Pro
# # stylists sign in with Clerk: email + password or Google. Not a secret.
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
