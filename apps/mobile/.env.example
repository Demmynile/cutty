# Not secrets — used only to build image URLs.
EXPO_PUBLIC_SANITY_PROJECT_ID=
EXPO_PUBLIC_SANITY_DATASET=production
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Origin of the apps/admin server, which hosts the API.
# Physical device: your dev machine's LAN IP, e.g. http://192.168.1.23:3002
# iOS simulator: http://localhost:3002   Android emulator: http://10.0.2.2:3002
EXPO_PUBLIC_API_URL=
