{
  "expo": {
    "name": "Cutty",
    "slug": "cutty",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "cutty",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cutty.barbershop"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111827"
      },
      "package": "com.cutty.barbershop"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#111827"
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cutty uses your photos to power AI style recommendations.",
          "cameraPermission": "Cutty uses your camera to capture a photo for AI style recommendations."
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
