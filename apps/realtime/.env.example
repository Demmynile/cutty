# Cutty realtime chat server (Socket.IO). Deploy on an always-on host
# (Railway, Fly.io, Render) — not Vercel, which can't hold WebSockets open.
PORT=4000

# Clerk secret key, same as apps/admin (CLERK_SECRET_KEY). Used to verify the
# Clerk session token the app sends when it connects.
CLERK_SECRET_KEY=
# Optional: PEM public key for networkless verification (same as apps/admin).
CLERK_JWT_KEY=

# Sanity project with a token that can read and write documents.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Shared with apps/admin (REALTIME_INTERNAL_SECRET there) so the API can push
# AI replies into a conversation. Use a long random string.
REALTIME_INTERNAL_SECRET=

# Comma-separated origins allowed to connect from a browser (the mobile app
# doesn't send an Origin header). Leave empty to allow only native clients.
ALLOWED_ORIGINS=

# Admin API origin, for Cutty AI away replies when a stylist is offline.
ADMIN_INTERNAL_URL=http://localhost:3002
# Optional: how long to wait before replying, in ms (default 20000).
# AWAY_REPLY_DELAY_MS=20000

# Comma-separated origins Clerk tokens must be issued for (same value as the
# admin API's CLERK_AUTHORIZED_PARTIES). Empty = any origin of this Clerk app.
CLERK_AUTHORIZED_PARTIES=

# Optional Redis URL. Required only when you run more than one realtime server:
# it relays messages and presence between them. Can be the same Redis as apps/admin.
REDIS_URL=
