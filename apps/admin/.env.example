NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token: the only Sanity credential. Server-side only.
SANITY_API_TOKEN=
# ≥ 32 random characters. Signs admin dashboard sessions only.
AUTH_JWT_SECRET=
# Clerk (customer + Cutty Pro sign-in in the mobile app). Secret key from the
# Clerk dashboard → API keys; apps/realtime needs the same value.
CLERK_SECRET_KEY=
# Optional: PEM public key (Clerk dashboard → API keys → JWT public key) to
# verify tokens without a network call to Clerk.
CLERK_JWT_KEY=
PAYSTACK_SECRET_KEY=
# Public origin of this server (used for Paystack's callback URL).
APP_PUBLIC_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_EFFORT=medium

# Cutty Pro live chat: where apps/realtime listens, and the shared secret it
# checks before broadcasting AI replies into a conversation.
REALTIME_INTERNAL_URL=http://localhost:4000
REALTIME_INTERNAL_SECRET=

# Optional: the shop's timezone for "today" and booking slots (default Africa/Lagos).
SHOP_TIMEZONE=Africa/Lagos

# Header your hosting proxy sets with the real client IP, used for rate
# limiting (e.g. cf-connecting-ip behind Cloudflare). Leave empty on Vercel,
# which sets x-real-ip. Never point this at a header clients can send.
TRUSTED_IP_HEADER=

# Comma-separated origins Clerk session tokens must be issued for (the token's
# azp claim). Set it in production so tokens minted for other apps on the same
# Clerk instance are refused. Use the same value in apps/realtime.
CLERK_AUTHORIZED_PARTIES=

# Optional Redis (redis://… or an Upstash rediss://… URL). When set, the public
# catalogue and stylist directory are cached there and rate limits are shared by
# every server instance — set it in production, especially on Vercel. Leave
# empty in local dev to use in-process limits and no cache.
REDIS_URL=

# Origins allowed to POST to /api/v1/waitlist (the marketing site, apps/web),
# comma-separated, e.g. https://cutty.app. http://localhost:3004 is always
# allowed in development.
WAITLIST_ALLOWED_ORIGINS=
